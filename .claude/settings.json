{
  "permissions": {
    "allow": [
      "Bash(git check-ignore *)",
      "Bash(bun x *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push origin master*)",
      "Bash(git push origin main*)",
      "Bash(git push origin integration*)",
      "Bash(git push -u origin master*)",
      "Bash(git push -u origin main*)",
      "Bash(git push -u origin integration*)",
      "Bash(git push --force origin master*)",
      "Bash(git push --force origin main*)",
      "Bash(git push --force origin integration*)",
      "Bash(git push --force-with-lease origin master*)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(git push --force-with-lease origin integration*)"
    ]
  },
  "enabledPlugins": {
    "astronomer-data-agents@claude-plugins-official": true,
    "expo@claude-plugins-official": true,
    "revenuecat@claude-plugins-official": true,
    "netlify-skills@claude-plugins-official": true,
    "product-tracking-skills@claude-plugins-official": true,
    "searchfit-seo@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  }
}
