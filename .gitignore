# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb

# OS
.DS_Store
Thumbs.db

# Convex
# NOTE: convex/_generated/ is committed so CI can typecheck without
# CONVEX_DEPLOYMENT credentials. `convex dev` regenerates it from
# convex/schema.ts + functions on every save; commit alongside schema changes.

# IDE
.vscode/
.idea/
*.swp
*.swo

# local scratch / secrets
.local.*

# Workspace-level .env files (use .env.local instead — see docs/ENVIRONMENTS.md)
apps/web/.env
apps/mobile/.env

# Graphify code knowledge graph — rebuilt on demand (~5s, $0), never committed.
# A committed graph goes stale the moment master moves, and a stale graph is a lie.
graphify-out/

# Playwright
test-results/
playwright-report/

# CodeSpring local config
.codespring/

# Agent scratch files. Wrappers read these; they must not be committed.
.tempo-commit-msg
.tempo-branch-name
.tempo-issue.md
.tempo-request.md

# Archify CLI checkout used by .github/workflows/archify.yml. Never commit.
.archify-skill/
